{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cadcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "Floor plans, hole patterns, dimensioning, layer cleanup and sheet output. Millimeter coordinates, layers and plot scales are verifiable.",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "cadcraft",
    "cad",
    "drafting",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CADCraft · 2D Drafting",
        "shortDescription": "Floor plans, hole patterns, dimensions and sheet output",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    }
  }
}
