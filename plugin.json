{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cadcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "房间平面、法兰孔系、尺寸标注、图层清理与图框出图；毫米坐标、图层与出图比例可复核。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "cadcraft",
    "cad",
    "drafting",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "CADCraft（二维制图）",
        "shortDescription": "平面图、孔系、标注与出图，可编辑图纸",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    }
  }
}
