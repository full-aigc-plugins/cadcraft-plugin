{
  "name": "cadcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "房间平面、法兰孔系、尺寸标注、图层清理与图框出图；毫米坐标、图层与出图比例可复核。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "cadcraft",
    "cad",
    "drafting",
    "mcp"
  ],
  "skills": "./skills/",
  "displayName": "CADCraft（二维制图）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "cadcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "CADCraft（二维制图）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "CADCraft (2D Drafting)",
          "zh-CN": "CADCraft（二维制图）"
        },
        "icon": "ruler",
        "server": "cadcraft-editor",
        "resourceUri": "ui://cadcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
