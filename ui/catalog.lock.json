  "resources": [
    {
      "name": "panel",
      "uri": "ui://cadcraft/panel.html",
      "mimeType": "text/html;profile=mcp-app",
      "_meta": {
        "ui": {
          "prefersBorder": false
        }
      }
    },
    {
      "name": "assets",
      "uri": "ui://cadcraft/assets.json",
      "mimeType": "application/json"
    }
  ],
  "resourceTemplates": [
    {
      "name": "asset-chunks",
      "uriTemplate": "ui://cadcraft/asset/{id}/{part}"
    },
    {
      "name": "file-chunks",
      "uriTemplate": "ui://cadcraft/file/{id}/{part}"
    }
  ]
}
