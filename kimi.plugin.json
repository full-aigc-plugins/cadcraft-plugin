{
  "name": "cadcraft",
  "version": "0.1.0-dev.20261109.4",
  "description": "画房间平面、法兰孔系和零件标注：毫米坐标、图层与出图比例都能逐项复核。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/cadcraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "cadcraft",
    "cad",
    "drafting",
    "mcp"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "CADCraft",
    "shortDescription": "画房间平面、法兰孔系和零件标注：毫米坐标、图层与出图比例都能逐项复核。",
    "longDescription": "Use CADCraft's native command engine through MCP to draw, inspect, render, and save 2D CAD documents. Requires cadcraft-cli on the host.",
    "developerName": "Full AIGC Plugins",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/full-aigc-plugins/cadcraft-plugin",
    "defaultPrompt": [
      "Create a CADCraft drawing and verify its geometry"
    ],
    "logo": "./assets/official-logo.png",
    "logoDark": "./assets/official-logo.png"
  },
  "mcpServers": {
    "cadcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "ui/bootstrap.mjs"
      ],
      "cwd": "./"
    }
  }
}
